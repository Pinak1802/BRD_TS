%%{init: {
  "theme": "default",
  "themeVariables": {
    "background": "#ffffff",
    "primaryColor": "#f4f7fb",
    "primaryBorderColor": "#526d82",
    "primaryTextColor": "#172b4d",
    "lineColor": "#526d82",
    "tertiaryColor": "#ffffff"
  }
}}%%
erDiagram
    direction TB
    scheme ||--o{ member : "has"
    employer ||--o{ employer_contact : "has"
    employer ||--o{ employer_scheme : "associates_with"
    scheme ||--o{ employer_scheme : "participates_in"
    member ||--o{ member_audit : "has_audit"
    member ||--o{ pension_account : "owns"
    scheme ||--o{ pension_account : "has_account"
    pension_account ||--o{ pension_account_audit : "has_audit"
    employer ||--o{ contribution_submission : "submits"
    scheme ||--o{ contribution_submission : "receives"
    employer ||--o{ contribution_receipt : "funds_receipt"
    member ||--o{ contribution_receipt : "belongs_to_receipt"
    scheme ||--o{ contribution_receipt : "receives_receipt"
    contribution_receipt ||--o{ contribution_allocation : "allocated"
    contribution_submission ||--o{ contribution_allocation : "allocated"
    member ||--o{ contribution_allocation : "credited"
    scheme ||--o{ contribution_allocation : "credits"
    contribution_submission ||--o{ reconciliation : "reconciled"
    contribution_receipt ||--o{ reconciliation : "reconciled"
    contribution_allocation ||--o{ reconciliation : "reconciled"
    reconciliation ||--o{ reconciliation_exception : "raises"
    pension_account ||--o{ investment : "holds"
    member ||--o{ investment : "owns_investment"
    scheme ||--o{ investment : "offers"
    investment ||--o{ investment_audit : "has_audit"
    member ||--o{ benefit_request : "requests"
    pension_account ||--o{ benefit_request : "linked"
    benefit_request ||--o{ benefit_validation : "validated"
    benefit_request ||--o{ benefit_workflow : "goes_through"
    benefit_request ||--o{ benefit_payment : "pays"
    user_role ||--o{ system_user : "assigned"
    employer ||--o{ system_user : "employs"
    audit_report ||--o{ material_action : "exports"

    scheme {
        int scheme_id PK
        string scheme_name
        string status
        string eligibility_rules
        date effective_from
        date effective_to
    }

    employer {
        int employer_id PK
        string employer_name
        string status
        string tax_id
    }

    employer_contact {
        int contact_id PK
        int employer_id FK
        string contact_name
        string email
        string phone
        date effective_from
        string reason
    }

    employer_scheme {
        int employer_scheme_id PK
        int employer_id FK
        int scheme_id FK
        date effective_from
    }

    member {
        int member_id PK
        string first_name
        string last_name
        date dob
        string national_insurance_number
        string status
    }

    member_audit {
        int audit_id PK
        int member_id FK
        string changed_by
        datetime changed_at
        string field_changed
        string old_value
        string new_value
    }

    pension_account {
        int account_id PK
        int member_id FK
        int scheme_id FK
        string status
        datetime opened_at
    }

    pension_account_audit {
        int audit_id PK
        int account_id FK
        string changed_by
        datetime changed_at
        string field_changed
        string old_value
        string new_value
    }

    contribution_submission {
        int submission_id PK
        int employer_id FK
        int scheme_id FK
        decimal submitted_amount
        date submission_date
        string status
    }

    contribution_receipt {
        int receipt_id PK
        int employer_id FK
        int member_id FK
        int scheme_id FK
        int account_id FK
        decimal received_amount
        datetime received_at
    }

    contribution_allocation {
        int allocation_id PK
        int submission_id FK
        int receipt_id FK
        int member_id FK
        int scheme_id FK
        int account_id FK
        decimal allocated_amount
    }

    reconciliation {
        int reconciliation_id PK
        int submission_id FK
        int receipt_id FK
        int allocation_id FK
        decimal submitted_amount
        decimal received_amount
        decimal allocated_amount
        decimal unmatched_amount
    }

    reconciliation_exception {
        int exception_id PK
        int reconciliation_id FK
        decimal reconciliation_amount
        string exception_type
        string status
        string resolution_outcome
        datetime resolved_at
    }

    financial_audit {
        int audit_id PK
        string entity_type
        int entity_id
        string actor
        string action
        datetime timestamp
        string values
        string outcome
    }

    investment {
        int investment_id PK
        int account_id FK
        int member_id FK
        int scheme_id FK
        string allocation_type
        decimal amount
        datetime created_at
    }

    investment_audit {
        int audit_id PK
        int investment_id FK
        string changed_by
        datetime changed_at
        string field_changed
        string old_value
        string new_value
    }

    benefit_request {
        int benefit_request_id PK
        int member_id FK
        int account_id FK
        string benefit_type
        decimal requested_amount
        string supporting_documentation
        string status
        datetime submitted_at
    }

    benefit_validation {
        int validation_id PK
        int benefit_request_id FK
        string validated_by
        datetime validated_at
        string result
        string rule_applied
        string validation_notes
    }

    benefit_workflow {
        int workflow_id PK
        int benefit_request_id FK
        string step
        string reviewer
        string decision
        datetime completed_at
    }

    benefit_payment {
        int payment_id PK
        int benefit_request_id FK
        decimal payment_amount
        date payment_date
        string payment_status
    }

    user_role {
        int role_id PK
        string role_name
        string permissions
    }

    system_user {
        int user_id PK
        string username
        int role_id FK
        int employer_id FK
        string duty_segment
    }

    audit_report {
        int report_id PK
        string report_type
        string generated_by
        datetime generated_at
        string format
        int audit_count
    }

    material_action {
        int material_action_id PK
        string actor
        string action_type
        string entity_type
        int entity_id
        datetime performed_at
        string details
    }
